# Constants/Variables
@BASE_URL= http://localhost:8000
@test_session_id = test-session

# Health endpoint - Check if service is up
GET {{BASE_URL}}/health

###
# Chat endpoint - Chat with the agent, use the same session id to keep the session.
POST {{BASE_URL}}/chat HTTP/1.1
Content-Type: application/json; charset=utf-8

{
    "message": "Hi, my name is Ana, Who are you?",
    "session_id": "{{test_session_id}}"
}

###
# History endpoint - Use to see messages in this session
GET {{BASE_URL}}/sessions/{{test_session_id}}/messages
